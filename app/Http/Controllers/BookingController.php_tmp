    // Check availability and return available rooms
    // TEMPORARILY DISABLED - Online booking coming soon
    public function checkAvailability(Request $request)
    {
        $request->validate([
            'check_in' => 'required|date|after_or_equal:today',
            'check_out' => 'required|date|after:check_in',
            'room_type' => 'required',
        ]);

        return response()->json(['message' => 'Online booking is temporarily disabled. Please contact reception at 0677-155-156.']);
    }

    // Find and assign an available room of the specified type
    public function assignAvailableRoom($roomType, $checkIn, $checkOut)
    {
        // Get all rooms of the requested type
        $rooms = Room::where('room_type', $roomType)->get();
        
        foreach ($rooms as $room) {
            // Check if the room is available for the given dates
            $isOccupied = Booking::where('room_id', $room->id)
                ->where(function ($query) use ($checkIn, $checkOut) {
                    $query->where(function ($q) use ($checkIn, $checkOut) {
                        $q->where('check_in', '>=', $checkIn)
                          ->where('check_in', '<', $checkOut);
                    })->orWhere(function ($q) use ($checkIn, $checkOut) {
                        $q->where('check_out', '>', $checkIn)
                          ->where('check_out', '<=', $checkOut);
                    })->orWhere(function ($q) use ($checkIn, $checkOut) {
                        $q->where('check_in', '<=', $checkIn)
                          ->where('check_out', '>=', $checkOut);
                    });
                })
                ->where('status', '!=', 'cancelled')
                ->exists();

            if (!$isOccupied) {
                return $room;
            }
        }

        return null;
    }

